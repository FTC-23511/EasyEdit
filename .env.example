# Postgres connection string. Create a free Neon project at https://neon.tech
# and copy the pooled connection string from its dashboard.
DATABASE_URL=

# Random secret for better-auth session signing. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL of the app, with no slash at the end. http://localhost:3000 locally, the Vercel URL in production.
# Claude connects to this address plus /api/mcp.
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client ID. Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
GOOGLE_CLIENT_ID=

# Google OAuth client secret, from the same OAuth client as GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_SECRET=

# Media storage (optional: without these two the app runs, and the Media tab says uploads are not set up).
# The Google service account's JSON key file, base64-encoded on one line: base64 -i key.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_KEY=

# The id of the folder that holds the media (a folder inside a Google shared drive, shared with the service account): the part of the folder's address after /folders/.
DRIVE_FOLDER_ID=
