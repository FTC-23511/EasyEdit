# Postgres connection string. Create a free Neon project at https://neon.tech
# and copy the pooled connection string from its dashboard.
DATABASE_URL=

# Random secret for better-auth session signing. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL of the app. http://localhost:3000 locally, the Vercel URL in production.
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client ID. Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
GOOGLE_CLIENT_ID=

# Google OAuth client secret, from the same OAuth client as GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_SECRET=
